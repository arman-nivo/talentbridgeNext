# --- Gmail SMTP (used by /api/contact) ---------------------------------
# 1. Turn on 2-Step Verification for the Google account.
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Copy this file to .env.local and fill in the values below.

# The Gmail / Google Workspace address that sends the emails
GMAIL_USER=you@gmail.com

# 16-character Google App Password (spaces are fine, they are stripped)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Inbox that receives new inquiries (defaults to GMAIL_USER when empty)
CONTACT_TO_EMAIL=enterprise@talentbridge-usbd.com
